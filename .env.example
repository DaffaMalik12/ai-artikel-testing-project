# =====================================================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya:
#     cp .env.example .env
# JANGAN pernah menulis nilai rahasia asli di file ini.
# =====================================================================

# --- Database ---------------------------------------------------------
# SQLite lokal. Untuk staging/production gunakan URL database yang aman.
DATABASE_URL="file:./dev.db"

# --- API --------------------------------------------------------------
# Base URL internal yang dipakai server saat memanggil endpoint API sendiri.
API_BASE_URL="http://localhost:3000"
# Daftar host yang diizinkan (dipisah koma, tanpa skema), mis. "localhost,app.example.com".
API_BASE_URL_ALLOWLIST="localhost"

# --- Upload gambar artikel -------------------------------------------
# Direktori penyimpanan file gambar. Bila relatif, di-resolve terhadap
# process.cwd(). Default: "public/uploads/artikel".
# Pada deployment container, arahkan ke volume persisten, mis. "/data/uploads/artikel".
UPLOAD_DIR="public/uploads/artikel"
# Batas ukuran maksimal satu file gambar dalam MB.
# Wajib bilangan bulat > 0. Default: 2.
# Nilai non-bilangan-bulat (mis. "2.9") akan dibulatkan ke bawah dan
# dicatat sebagai peringatan di log; nilai tidak valid jatuh ke default.
MAX_UPLOAD_SIZE_MB="2"
