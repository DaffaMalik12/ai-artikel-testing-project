generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Artikel {
  id        Int      @id @default(autoincrement())
  judul     String
  isi       String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("artikel")
}
